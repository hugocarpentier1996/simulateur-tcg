{
  "name": "simulateur-tcg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest --watch",
